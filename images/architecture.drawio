<mxfile host="app.diagrams.net"><diagram name="HuntCraft · how a manual gets from the author to a member"><mxGraphModel dx="1200" dy="900" grid="0" background="#0f141c" page="1" pageWidth="1300" pageHeight="1024"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="HuntCraft · how a manual gets from the author to a member" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#eef2f7;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="34" as="geometry"/></mxCell><mxCell id="lg0" value="Author's computer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg1" value="Cyber Range" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#2a1f3d;strokeColor=#b48cff;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg2" value="Cloudflare" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg3" value="Member" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#123236;strokeColor=#4fd1d9;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg4" value="Decision / note" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;Start:&lt;/b&gt; a practice hunt's questions&lt;br&gt;on the author's computer." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="380" height="74" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;A local generator:&lt;/b&gt; Claude solves each&lt;br&gt;flag and drafts the steps." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="244" width="380" height="74" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;A local review page:&lt;/b&gt; every query re-run,&lt;br&gt;a leak check, a person signs off each flag." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="358" width="380" height="74" as="geometry"/></mxCell><mxCell id="q1" value="Practice hunt, cleared&lt;br&gt;to publish, no contact&lt;br&gt;details on the page?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="472" width="300" height="120" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Cloudflare Pages:&lt;/b&gt; a plain page with&lt;br&gt;the steps and queries, no answers inside." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="632" width="380" height="74" as="geometry"/></mxCell><mxCell id="d" value="The member runs each query in their&lt;br&gt;&lt;b&gt;own Microsoft Defender&lt;/b&gt;." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#123236;strokeColor=#4fd1d9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="746" width="380" height="74" as="geometry"/></mxCell><mxCell id="z" value="&lt;b&gt;End:&lt;/b&gt; a correct guess or a Reveal&lt;br&gt;loads that flag's answer." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#123236;strokeColor=#4fd1d9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="860" width="380" height="74" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Cyber Range MCP:&lt;/b&gt; read-only&lt;br&gt;log searches over the&lt;br&gt;hunt's own workspace." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#2a1f3d;strokeColor=#b48cff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="229.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;No: the build stops.&lt;/b&gt;&lt;br&gt;A live hunt never ships." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="492.0" width="320" height="80" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Request a hunt:&lt;/b&gt; a Worker checks&lt;br&gt;the form, a spam check and a&lt;br&gt;5-an-hour limit, saves the request&lt;br&gt;to a database, sends one email." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="605.0" width="320" height="128" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="s" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="b" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="q1" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="d" target="z"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="n1" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="q1" target="n0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="form" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="c" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>