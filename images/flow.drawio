<mxfile host="app.diagrams.net"><diagram name="HuntCraft · how a member finds each flag on their own"><mxGraphModel dx="1200" dy="900" grid="0" background="#0f141c" page="1" pageWidth="1300" pageHeight="1138"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="HuntCraft · how a member finds each flag on their own" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#eef2f7;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="34" as="geometry"/></mxCell><mxCell id="lg0" value="Member" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg1" value="The manual" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg2" value="Microsoft Defender" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#123236;strokeColor=#4fd1d9;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg3" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#173326;strokeColor=#5fd38d;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg4" value="Decision / note" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;Start:&lt;/b&gt; a member picks a practice hunt&lt;br&gt;and opens its manual." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="380" height="74" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;Orientation:&lt;/b&gt; the logs to search, the two&lt;br&gt;clocks, and setting Defender to UTC." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="244" width="380" height="74" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;Each flag:&lt;/b&gt; the goal, where to look,&lt;br&gt;and why there and not somewhere else." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="358" width="380" height="74" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;One query at a time&lt;/b&gt;, with the reason for it.&lt;br&gt;Open in Defender runs it in one click." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#123236;strokeColor=#4fd1d9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="472" width="380" height="74" as="geometry"/></mxCell><mxCell id="d" value="The member reads the result for the&lt;br&gt;&lt;b&gt;pattern described&lt;/b&gt;, never a given value." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="586" width="380" height="74" as="geometry"/></mxCell><mxCell id="q1" value="Does the member's&lt;br&gt;answer match?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="700" width="300" height="120" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;Correct:&lt;/b&gt; points are added, and the&lt;br&gt;answer and why it matters unlock." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#173326;strokeColor=#5fd38d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="860" width="380" height="74" as="geometry"/></mxCell><mxCell id="z" value="&lt;b&gt;End:&lt;/b&gt; each flag builds on the last. When&lt;br&gt;all are done, request the next hunt." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="974" width="380" height="74" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;No:&lt;/b&gt; try again, open a hint,&lt;br&gt;or Reveal the answer (no points)." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="720.0" width="320" height="80" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;No answer is on the page.&lt;/b&gt;&lt;br&gt;A guess is checked against a&lt;br&gt;scrambled copy (a hash)." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="343.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;The site never runs a query&lt;/b&gt;&lt;br&gt;or calls an AI. The member&lt;br&gt;does the hunting." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="457.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="s" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="d" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="q1" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="e" target="z"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="q1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="n2" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="n3" target="c"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>